; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="JOSEONLIKE"
config/description="Joseon-inspired pixel roguelike survival action RPG"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

SaveManager="*res://scripts/core/save_manager.gd"
MusicManager="*res://scripts/core/music_player.gd"
SfxManager="*res://scripts/core/sfx_player.gd"
DisplayAdapter="*res://scripts/core/display_adapter.gd"
SceneFade="*res://scripts/core/scene_fade.gd"

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/size/resizable=false
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/handheld/orientation=6

[gui]

theme/custom="res://asset/ui_theme.tres"

[input]

