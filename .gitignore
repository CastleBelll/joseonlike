# Godot 4+
.godot/
# .import sidecars are generated by `godot --import`; only customized ones are tracked.
*.import
!asset/font/neodgm.ttf.import
/android/
/build/
/export/
*.translation

# Exported binaries
*.apk
*.aab
*.ipa
*.exe
*.pck
*.zip

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets — never commit keystores or signing config
*.keystore
*.jks
export_credentials.cfg
.env

# Godot editor thumbnail cache
.thumbs/

# Vercel CLI link state — holds the project/org ids for this checkout.
# Not secret on its own, but it is per-developer local state, not project config.
/.vercel/

.vercel
.env*

# N9-74: owner-sourced asset packs live in new_asset/owner/ and stay OUT of the
# repo — they are large third-party source material, and the game never loads
# anything under new_asset/ directly. Reorganising the drop box once staged
# 4,478 pack files by accident; this makes that impossible rather than
# careful. The handful of owner files already tracked stay tracked: a gitignore
# rule does not apply to files git already knows about.
new_asset/owner/

# itch.io hand-upload artifacts, built locally on demand
joseonlike_web.zip
itch_assets/
__pycache__/
